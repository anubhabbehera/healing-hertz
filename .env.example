# --- UniFi console connection (required unless DEMO_MODE=true) ---
# The LOCAL address of the device running the UniFi Network application — i.e. the
# same IP/hostname you type into the browser to open your UniFi management UI.
#   * UniFi gateway/console (UDM, UDM Pro/SE, UDR, UCG, Cloud Key): usually your
#     router's LAN IP, e.g. 192.168.1.1 (https://192.168.1.1 shows the UniFi login).
#   * Self-hosted Network Server (Docker/Linux/Windows): that machine's IP; also set
#     UNIFI_PORT=8443 and UNIFI_API_PREFIX=/integration below.
# Do NOT use unifi.ui.com — the cloud portal is not the local API.
UNIFI_HOST=192.168.1.1
# UniFi Network API key. Create it in the UniFi UI: Settings -> Control Plane ->
# Integrations -> Create API Key (older versions: Settings -> API, or your admin
# profile -> API keys). Keys inherit the creating admin's permissions — creating it
# from a "View Only" admin account keeps this app strictly read-only.
UNIFI_API_KEY=
UNIFI_PORT=443
# Consoles use a self-signed certificate by default; set true only with a valid cert
UNIFI_TLS_VERIFY=false
# UniFi OS consoles: /proxy/network/integration
# Self-hosted Network Server: /integration  (and usually UNIFI_PORT=8443)
UNIFI_API_PREFIX=/proxy/network/integration
# Site name; leave empty to use the first site on the console
UNIFI_SITE=

# --- Optional: per-client RSSI + roaming detection (legacy controller API) ---
# The Integration API can't see client signal strength or roaming. If you create a
# dedicated LOCAL admin with the "View Only" role and put its credentials here, the
# app also collects per-client RF data + roam events via the legacy API. Unofficial
# API: may shift across firmware updates; failures are logged and skipped.
UNIFI_USERNAME=
UNIFI_PASSWORD=

# --- Optional: NextDNS integration (DNS anomaly detection) ---
# API key: https://my.nextdns.io/account   Profile ID: the 6-char id in your
# NextDNS profile URL (my.nextdns.io/<PROFILE_ID>/setup).
NEXTDNS_API_KEY=
NEXTDNS_PROFILE_ID=

# --- WAN health probe (latency/jitter/loss from this machine; no credentials) ---
WAN_PROBE=true

# --- AI advisor (optional; rules-only diagnostics without it) ---
# API key for the advisor endpoint (Anthropic key, or your gateway's key, e.g.
# an OpenRouter sk-or-... key when ANTHROPIC_BASE_URL points at OpenRouter).
ANTHROPIC_API_KEY=
# Leave empty for the official Anthropic API. To use another provider, set any
# endpoint that speaks the Anthropic Messages API, e.g.:
#   OpenRouter:  https://openrouter.ai/api   (use model ids like anthropic/claude-sonnet-4.5)
#   LiteLLM:     http://localhost:4000
ANTHROPIC_BASE_URL=
# Model id as your endpoint expects it (gateways often use vendor-prefixed ids).
ADVISOR_MODEL=claude-sonnet-5
ADVISOR_MAX_TOKENS=8192

# --- App ---
DB_PATH=./healing_hertz.db
# true = use bundled sample telemetry instead of a real console
DEMO_MODE=false

# Directory of your own diagnostic checks, as .yaml files. Empty = disabled.
# Every rule id must start with "custom." so it can never collide with a
# built-in one. A file that fails to load is skipped and reported in the UI's
# "not checkable" list rather than failing the scan; check it up front with:
#   uv run python -m app.rules.validate
# See CONTRIBUTING.md for the schema.
RULES_DIR=
